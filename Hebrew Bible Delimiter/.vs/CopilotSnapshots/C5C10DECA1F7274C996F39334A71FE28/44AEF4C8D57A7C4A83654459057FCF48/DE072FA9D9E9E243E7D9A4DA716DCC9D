# -*- coding: utf-8 -*-
"""A simple text interface for the Hebrew Bible delimiter processor."""

import html
import os
import re
import tempfile
import tkinter as tk
import webbrowser
from tkinter import filedialog, messagebox, ttk
from xml.sax.saxutils import escape
from zipfile import ZIP_DEFLATED, ZipFile

from Hebrew_Bible_Delimiter import process_text


_MARKER_SUFFIX = re.compile(r"((?:\((?:Potential )?\d+-(?:II|III|IV|V)\))+)\Z")


def _rtl_preview_html(text):
    escaped = html.escape(text)
    escaped = re.sub(
        r"\((?:Potential )?\d+-(?:II|III|IV|V)\)",
        lambda marker: '<bdi dir="ltr">' + marker.group(0) + "</bdi>",
        escaped,
    )
    return (
        '<!doctype html><html lang="he" dir="rtl"><head>'
        '<meta charset="utf-8"><title>Hebrew Bible Delimiter</title>'
        '<style>body{font:18pt "Segoe UI",sans-serif;margin:2em}'
        'pre{white-space:pre-wrap;unicode-bidi:plaintext}</style></head>'
        '<body><pre dir="rtl">' + escaped + "</pre></body></html>"
    )


def _word_run(text, right_to_left):
    if not text:
        return ""
    direction = "<w:rtl/>" if right_to_left else '<w:rtl w:val="0"/>'
    language = '<w:lang w:val="he-IL" w:bidi="he-IL"/>' if right_to_left else '<w:lang w:val="en-US"/>'
    return (
        "<w:r><w:rPr><w:rFonts w:ascii=\"SBL Hebrew\" w:hAnsi=\"SBL Hebrew\" "
        "w:cs=\"SBL Hebrew\" w:eastAsia=\"SBL Hebrew\"/>" + direction + language +
        "</w:rPr><w:t xml:space=\"preserve\">" + escape(text) + "</w:t></w:r>"
    )


def _word_paragraph(line):
    marker_pattern = re.compile(r"\((?:Potential )?\d+-(?:II|III|IV|V)\)")
    runs = []
    offset = 0
    for marker in marker_pattern.finditer(line):
        runs.append(_word_run(line[offset:marker.start()], True))
        runs.append(_word_run(marker.group(0), False))
        offset = marker.end()
    runs.append(_word_run(line[offset:], True))
    return (
        '<w:p><w:pPr><w:bidi/><w:jc w:val="start"/></w:pPr>' +
        "".join(runs) + "</w:p>"
    )


def save_word_document(path, text):
    paragraphs = "".join(_word_paragraph(line) for line in text.split("\n"))
    document_xml = (
        '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
        '<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">'
        '<w:body>' + paragraphs +
        '<w:sectPr><w:pgSz w:w="11906" w:h="16838"/>'
        '<w:pgMar w:top="1417" w:right="1417" w:bottom="1417" w:left="1417" '
        'w:header="708" w:footer="708" w:gutter="0"/></w:sectPr>'
        '</w:body></w:document>'
    )
    content_types = (
        '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
        '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">'
        '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>'
        '<Default Extension="xml" ContentType="application/xml"/>'
        '<Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/>'
        '</Types>'
    )
    relationships = (
        '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>'
        '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">'
        '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/>'
        '</Relationships>'
    )
    with ZipFile(path, "w", ZIP_DEFLATED) as document:
        document.writestr("[Content_Types].xml", content_types)
        document.writestr("_rels/.rels", relationships)
        document.writestr("word/document.xml", document_xml)


class HebrewBibleDelimiterApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Hebrew Bible Delimiter")
        self.root.geometry("1000x600")
        self.root.minsize(700, 400)
        self.saved_word_path = None

        self.root.columnconfigure(0, weight=1)
        self.root.rowconfigure(0, weight=1)

        panes = ttk.Frame(root, padding=12)
        panes.grid(row=0, column=0, sticky="nsew")
        panes.columnconfigure(0, weight=1)
        panes.columnconfigure(1, weight=1)
        panes.rowconfigure(1, weight=1)

        ttk.Label(panes, text="Hebrew text").grid(row=0, column=0, sticky="w", padx=(0, 8), pady=(0, 6))
        ttk.Label(panes, text="Processed output (logical text order)").grid(row=0, column=1, sticky="w", padx=(8, 0), pady=(0, 6))

        self.input_text = self._create_text_area(panes, row=1, column=0, padx=(0, 8))
        self.output_text = self._create_text_area(panes, row=1, column=1, padx=(8, 0))

        button_row = ttk.Frame(panes)
        button_row.grid(row=2, column=0, columnspan=2, pady=(12, 0))
        ttk.Button(button_row, text="Process", command=self.process).grid(row=0, column=0, padx=4)
        ttk.Button(button_row, text="Clear", command=self.clear).grid(row=0, column=1, padx=4)
        ttk.Button(button_row, text="Save Word", command=self.save_word).grid(row=0, column=2, padx=4)
        ttk.Button(button_row, text="RTL Preview", command=self.open_rtl_preview).grid(row=0, column=3, padx=4)
        ttk.Button(button_row, text="Quit", command=root.destroy).grid(row=0, column=4, padx=4)

    @staticmethod
    def _create_text_area(parent, row, column, padx):
        frame = ttk.Frame(parent)
        frame.grid(row=row, column=column, sticky="nsew", padx=padx)
        frame.rowconfigure(0, weight=1)
        frame.columnconfigure(0, weight=1)

        text = tk.Text(frame, wrap="word", undo=True, font=("Segoe UI", 12))
        text.tag_configure("hebrew", justify="right")

        def align_text(event):
            widget = event.widget
            widget.tag_add("hebrew", "1.0", "end")
            widget.edit_modified(False)

        text.bind("<<Modified>>", align_text)
        text.grid(row=0, column=0, sticky="nsew")

        scrollbar = ttk.Scrollbar(frame, orient="vertical", command=text.yview)
        scrollbar.grid(row=0, column=1, sticky="ns")
        text.configure(yscrollcommand=scrollbar.set)
        return text

    def process(self):
        text = self.input_text.get("1.0", "end-1c")
        result = process_text(text)
        self.output_text.delete("1.0", "end")
        self.output_text.insert("1.0", result, "hebrew")

    def save_word(self):
        text = self.output_text.get("1.0", "end-1c")
        if not text:
            messagebox.showinfo("Save Word", "Process some text first.", parent=self.root)
            return

        path = filedialog.asksaveasfilename(
            parent=self.root,
            title="Save formatted Word document",
            defaultextension=".docx",
            filetypes=(("Word document", "*.docx"),),
        )
        if not path:
            return

        try:
            save_word_document(path, text)
        except OSError as error:
            messagebox.showerror("Save Word", f"Could not save the document:\n{error}", parent=self.root)
            return
        self.saved_word_path = path
        messagebox.showinfo("Save Word", "Word document saved successfully.", parent=self.root)

    def open_word(self):
        if self.saved_word_path is None:
            messagebox.showinfo("Open Word", "Please save the Word document first.", parent=self.root)
            return

        try:
            os.startfile(self.saved_word_path)
        except OSError as error:
            messagebox.showerror("Open Word", f"Could not open the Word document:\n{error}", parent=self.root)

    def open_rtl_preview(self):
        text = self.output_text.get("1.0", "end-1c")
        if not text:
            messagebox.showinfo("RTL Preview", "Process some text first.", parent=self.root)
            return

        with tempfile.NamedTemporaryFile(
            mode="w", encoding="utf-8", suffix=".html", delete=False
        ) as preview_file:
            preview_file.write(_rtl_preview_html(text))
            preview_path = preview_file.name

        if not webbrowser.open_new_tab(preview_path):
            messagebox.showerror("RTL Preview", "Could not open the preview in a browser.", parent=self.root)

    def clear(self):
        self.input_text.delete("1.0", "end")
        self.output_text.delete("1.0", "end")


def main():
    root = tk.Tk()
    HebrewBibleDelimiterApp(root)
    root.mainloop()


if __name__ == "__main__":
    main()
